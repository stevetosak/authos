{
  "name": "@authoss/duster-angular",
  "version": "0.0.0",
  "description": "Angular bindings for @authoss/duster-core — provideDuster(), DusterService, dusterAuthGuard.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevetosak/authos.git",
    "directory": "packages/angular"
  },
  "homepage": "https://github.com/stevetosak/authos/tree/master/packages/angular#readme",
  "bugs": "https://github.com/stevetosak/authos/issues",
  "keywords": [
    "duster",
    "authos",
    "angular",
    "oauth2",
    "oidc",
    "authentication",
    "signals"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@authoss/duster-core": "*",
    "tslib": "^2.3.0"
  },
  "peerDependencies": {
    "@angular/core": "^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0",
    "@angular/router": "^19.0.0 || ^20.0.0 || ^21.0.0 || ^22.0.0",
    "rxjs": "^7.4.0"
  },
  "devDependencies": {
    "@angular/common": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "rxjs": "^7.8.0",
    "tsup": "^8.5.0",
    "typescript": "~5.8.3",
    "zone.js": "^0.15.0"
  }
}
