{
  "name": "@authoss/duster-vue",
  "version": "0.0.0",
  "description": "Vue 3 bindings for @authoss/duster-core — createDuster() plugin, useDuster(), <ProtectedRoute>.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stevetosak/authos.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/stevetosak/authos/tree/master/packages/vue#readme",
  "bugs": "https://github.com/stevetosak/authos/issues",
  "keywords": [
    "duster",
    "authos",
    "vue",
    "oauth2",
    "oidc",
    "authentication",
    "composables"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@authoss/duster-core": "*"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "typescript": "~5.7.2",
    "vue": "^3.5.13"
  }
}
