{
  "name": "@authoss/duster-sdk",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace for the Duster browser SDK (@authoss/duster-core + framework adapters).",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "core"
  ],
  "scripts": {
    "build": "npm run build -w @authoss/duster-core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "clean": "rimraf \"*/dist\" \"*/coverage\" \"*/*.tsbuildinfo\"",
    "sync-license": "node scripts/sync-license.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "rimraf": "^6.0.1",
    "tsup": "^8.5.0",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.24.1",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20.19"
  }
}
